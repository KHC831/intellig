{
  "$comment": "Scoped autonomy config for the git4idea-parity implementation. Allows the build/test/search/git-read commands this work needs so they run without prompting; everything else still asks. See docs/parity/full-parity-audit-2026-06-15.md.",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "TodoWrite",
      "Task",

      "Bash(npm run build:*)",
      "Bash(npm run compile:*)",
      "Bash(npm run watch:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run lint:fix:*)",
      "Bash(npm run format:*)",
      "Bash(npm run format:check:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run test:unit:*)",
      "Bash(npm run test:property:*)",
      "Bash(npm run check:*)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier:*)",
      "Bash(npx mocha:*)",
      "Bash(node scripts/*)",
      "Bash(node -e:*)",

      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-list:*)",
      "Bash(git rev-parse:*)",
      "Bash(git blame:*)",
      "Bash(git ls-files:*)",
      "Bash(git remote:*)",
      "Bash(git config --get:*)",
      "Bash(git for-each-ref:*)",
      "Bash(git merge-base:*)",
      "Bash(git stash list:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git merge --squash:*)",
      "Bash(git merge --abort:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -d:*)",
      "Bash(git worktree:*)",

      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(diff:*)",
      "Bash(tree:*)",
      "Bash(echo:*)",
      "Bash(true:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(pwd:*)",
      "Bash(which:*)",
      "Bash(jq:*)"
    ],
    "ask": [
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(npm run release:*)",
      "Bash(npm publish:*)",
      "Bash(npm run package:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/*.pem)",
      "Read(./**/id_rsa)"
    ]
  }
}
