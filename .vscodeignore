# ============================================================
# The extension is BUNDLED: dist/extension.js carries the host
# code and every runtime dependency (esbuild, see
# `npm run build:extension`), and the webview assets live under
# media/ (mergeWindow.js bundle, codicon.ttf, monaco/vs copied
# from monaco-editor at compile time). NOTHING ships from
# node_modules/ or out/ — both are excluded wholesale below, with
# no re-includes.
#
# ORDERING MATTERS. Do NOT add any `!` re-include without
# auditing: the 365→108 file regression on 2026-05-15 was caused
# by a `!out/**/*.js` re-include silently overriding
# `out/test/**`.
#
# Structural guard: `npm run check:vsix-clean` runs `vsce ls`,
# greps for forbidden patterns AND asserts the runtime manifest
# (dist/extension.js + media assets) is present. Run it before
# any change to this file.
# ============================================================
.vscode/**
.vscode-test/**
.kiro/**
.git/**
.github/**
.agent/**
.claude/**
.idea/**
.DS_Store
node_modules/**
out/**
out-test/**
src/**
test/**
workspace-notes/**
# Icon source assets — only the shipped raster (images/icon.png) belongs in the
# package; the editable SVG source and the high-res render are repo-only.
images/*.svg
images/icon@*.png
# README screenshots are served from GitHub (absolute raw URLs) on the
# marketplace, so the local copies are repo-only and don't bloat the package.
images/screenshots/**
docs/**
scripts/**
.eslintrc.json
.prettierrc
.prettierignore
.mocharc.json
.gitignore
tsconfig.json
tsconfig.test.json
package-lock.json
CONTRIBUTING.md
CLAUDE.md
AGENT_WORKSPACE.md
# c8 coverage output (coverage-final.json + tmp/ per-process V8 dumps) —
# 35 MB of pure bloat that shipped unnoticed in 0.2.10.
coverage/**
**/*.map
**/*.ts
# The monaco version marker is a build-cache detail, not a runtime asset.
media/monaco/.version
# Build artifacts — packaged .vsix files and any unpacked package dirs must not
# get swept back into a new package (0.2.3 shipped them by accident). The second
# glob is required: vsce matches per-file, so `intellig*` alone catches the root
# .vsix but not the CONTENTS of an unpacked `intellig-*/` directory.
intellig*
intellig*/**
