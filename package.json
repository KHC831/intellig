{
  "name": "intellig",
  "displayName": "IntelliG",
  "description": "IntelliG Git integration for VS Code",
  "version": "0.0.1",
  "publisher": "intellig-vscode",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "intellij",
    "version control",
    "scm",
    "source control"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/KHC831/intellig"
  },
  "bugs": {
    "url": "https://github.com/KHC831/intellig/issues"
  },
  "homepage": "https://github.com/KHC831/intellig#readme",
  "license": "MIT",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "intellig.openGitToolWindow",
        "title": "Open Git Tool Window",
        "category": "IntelliG",
        "icon": "$(git-branch)"
      },
      {
        "command": "intellig.commit",
        "title": "Commit",
        "category": "IntelliG",
        "icon": "$(check)"
      },
      {
        "command": "intellig.push",
        "title": "Push",
        "category": "IntelliG",
        "icon": "$(arrow-up)"
      },
      {
        "command": "intellig.pull",
        "title": "Pull",
        "category": "IntelliG",
        "icon": "$(arrow-down)"
      },
      {
        "command": "intellig.fetch",
        "title": "Fetch",
        "category": "IntelliG",
        "icon": "$(sync)"
      },
      {
        "command": "intellig.showBranchPopup",
        "title": "Show Branch Popup",
        "category": "IntelliG",
        "icon": "$(git-branch)"
      },
      {
        "command": "intellig.refresh",
        "title": "Refresh",
        "category": "IntelliG",
        "icon": "$(refresh)"
      },
      {
        "command": "intellig.stageSelected",
        "title": "Stage Selected Files",
        "category": "IntelliG",
        "icon": "$(add)"
      },
      {
        "command": "intellig.unstageSelected",
        "title": "Unstage Selected Files",
        "category": "IntelliG",
        "icon": "$(remove)"
      },
      {
        "command": "intellig.branch.checkout",
        "title": "Checkout",
        "category": "IntelliG"
      },
      {
        "command": "intellig.branch.newBranchFrom",
        "title": "New Branch from Here",
        "category": "IntelliG"
      },
      {
        "command": "intellig.branch.mergeIntoCurrent",
        "title": "Merge into Current",
        "category": "IntelliG"
      },
      {
        "command": "intellig.branch.rebaseCurrentOnto",
        "title": "Rebase Current onto This",
        "category": "IntelliG"
      },
      {
        "command": "intellig.branch.compareWithCurrent",
        "title": "Compare with Current",
        "category": "IntelliG"
      },
      {
        "command": "intellig.branch.rename",
        "title": "Rename...",
        "category": "IntelliG"
      },
      {
        "command": "intellig.branch.delete",
        "title": "Delete",
        "category": "IntelliG"
      },
      {
        "command": "intellig.branch.update",
        "title": "Update",
        "category": "IntelliG"
      },
      {
        "command": "intellig.branch.push",
        "title": "Push...",
        "category": "IntelliG"
      },
      {
        "command": "intellig.branch.showDiffWithWorkingTree",
        "title": "Show Diff with Working Tree",
        "category": "IntelliG"
      },
      {
        "command": "intellig.branch.checkoutAndRebase",
        "title": "Checkout and Rebase",
        "category": "IntelliG"
      },
      {
        "command": "intellig.remoteBranch.checkoutAsLocal",
        "title": "Checkout",
        "category": "IntelliG"
      },
      {
        "command": "intellig.remoteBranch.cherryPickCommits",
        "title": "Cherry-pick Commits",
        "category": "IntelliG"
      },
      {
        "command": "intellig.remoteBranch.pullIntoCurrent",
        "title": "Pull into Current",
        "category": "IntelliG"
      },
      {
        "command": "intellig.remoteBranch.pullUsingRebase",
        "title": "Pull Using Rebase",
        "category": "IntelliG"
      },
      {
        "command": "intellig.remoteBranch.pullUsingMerge",
        "title": "Pull Using Merge",
        "category": "IntelliG"
      },
      {
        "command": "intellig.merge.openMergeView",
        "title": "Open Merge View",
        "category": "IntelliG"
      },
      {
        "command": "intellig.merge.acceptCurrent",
        "title": "Accept Current",
        "category": "IntelliG"
      },
      {
        "command": "intellig.merge.acceptIncoming",
        "title": "Accept Incoming",
        "category": "IntelliG"
      },
      {
        "command": "intellig.merge.acceptBoth",
        "title": "Accept Both",
        "category": "IntelliG"
      },
      {
        "command": "intellig.merge.acceptAllCurrent",
        "title": "Accept All Current",
        "category": "IntelliG"
      },
      {
        "command": "intellig.merge.acceptAllIncoming",
        "title": "Accept All Incoming",
        "category": "IntelliG"
      },
      {
        "command": "intellig.merge.nextConflict",
        "title": "Next Conflict",
        "category": "IntelliG"
      },
      {
        "command": "intellig.merge.previousConflict",
        "title": "Previous Conflict",
        "category": "IntelliG"
      },
      {
        "command": "intellig.merge.markResolved",
        "title": "Mark as Resolved",
        "category": "IntelliG"
      },
      {
        "command": "intellig.remoteBranch.deleteRemote",
        "title": "Delete",
        "category": "IntelliG"
      },
      {
        "command": "intellig.tag.checkoutDetached",
        "title": "Checkout (Detached)",
        "category": "IntelliG"
      },
      {
        "command": "intellig.tag.newBranchFrom",
        "title": "New Branch from Here",
        "category": "IntelliG"
      },
      {
        "command": "intellig.tag.cherryPick",
        "title": "Cherry-pick",
        "category": "IntelliG"
      },
      {
        "command": "intellig.tag.delete",
        "title": "Delete Tag",
        "category": "IntelliG"
      },
      {
        "command": "intellig.tag.push",
        "title": "Push Tag",
        "category": "IntelliG"
      },
      {
        "command": "intellig.branches.refresh",
        "title": "Refresh Branches",
        "category": "IntelliG",
        "icon": "$(refresh)"
      },
      {
        "command": "intellig.rebase.interactive",
        "title": "Interactive Rebase...",
        "category": "IntelliG"
      },
      {
        "command": "intellig.showHistory",
        "title": "Show History",
        "category": "IntelliG",
        "icon": "$(history)"
      },
      {
        "command": "intellig.revertFile",
        "title": "Revert File",
        "category": "IntelliG",
        "icon": "$(discard)"
      },
      {
        "command": "intellig.explorer.showHistory",
        "title": "Git: Show History",
        "category": "IntelliG",
        "icon": "$(history)"
      },
      {
        "command": "intellig.explorer.compareWithBranch",
        "title": "Git: Compare with Branch...",
        "category": "IntelliG",
        "icon": "$(git-compare)"
      },
      {
        "command": "intellig.explorer.revert",
        "title": "Git: Revert",
        "category": "IntelliG",
        "icon": "$(discard)"
      },
      {
        "command": "intellig.explorer.stage",
        "title": "Git: Stage",
        "category": "IntelliG",
        "icon": "$(add)"
      },
      {
        "command": "intellig.explorer.unstage",
        "title": "Git: Unstage",
        "category": "IntelliG",
        "icon": "$(remove)"
      },
      {
        "command": "intellig.explorer.showDiff",
        "title": "Git: Show Diff",
        "category": "IntelliG",
        "icon": "$(diff)"
      },
      {
        "command": "intellig.editor.toggleBlame",
        "title": "Git: Toggle Blame Annotations",
        "category": "IntelliG",
        "icon": "$(git-commit)"
      },
      {
        "command": "intellig.editor.showLineHistory",
        "title": "Git: Show Line History",
        "category": "IntelliG",
        "icon": "$(history)"
      },
      {
        "command": "intellig.editor.copyCommitHash",
        "title": "Git: Copy Commit Hash",
        "category": "IntelliG",
        "icon": "$(clippy)"
      },
      {
        "command": "intellig.editor.showCommit",
        "title": "Git: Show Commit",
        "category": "IntelliG",
        "icon": "$(git-commit)"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "intellig.branch.newBranchFrom",
          "when": "viewItem == intellig.localBranchCurrent",
          "group": "1_branchOps@1"
        },
        {
          "command": "intellig.branch.update",
          "when": "viewItem == intellig.localBranchCurrent",
          "group": "2_sync@1"
        },
        {
          "command": "intellig.branch.push",
          "when": "viewItem == intellig.localBranchCurrent",
          "group": "2_sync@2"
        },
        {
          "command": "intellig.branch.rename",
          "when": "viewItem == intellig.localBranchCurrent",
          "group": "3_manage@1"
        },
        {
          "command": "intellig.branch.checkout",
          "when": "viewItem == intellig.localBranch",
          "group": "1_branchOps@1"
        },
        {
          "command": "intellig.branch.newBranchFrom",
          "when": "viewItem == intellig.localBranch",
          "group": "1_branchOps@2"
        },
        {
          "command": "intellig.branch.checkoutAndRebase",
          "when": "viewItem == intellig.localBranch",
          "group": "1_branchOps@3"
        },
        {
          "command": "intellig.branch.compareWithCurrent",
          "when": "viewItem == intellig.localBranch",
          "group": "2_compare@1"
        },
        {
          "command": "intellig.branch.showDiffWithWorkingTree",
          "when": "viewItem == intellig.localBranch",
          "group": "2_compare@2"
        },
        {
          "command": "intellig.branch.rebaseCurrentOnto",
          "when": "viewItem == intellig.localBranch",
          "group": "3_integrate@1"
        },
        {
          "command": "intellig.branch.mergeIntoCurrent",
          "when": "viewItem == intellig.localBranch",
          "group": "3_integrate@2"
        },
        {
          "command": "intellig.branch.update",
          "when": "viewItem == intellig.localBranch",
          "group": "4_sync@1"
        },
        {
          "command": "intellig.branch.push",
          "when": "viewItem == intellig.localBranch",
          "group": "4_sync@2"
        },
        {
          "command": "intellig.branch.rename",
          "when": "viewItem == intellig.localBranch",
          "group": "5_manage@1"
        },
        {
          "command": "intellig.branch.delete",
          "when": "viewItem == intellig.localBranch",
          "group": "5_manage@2"
        },
        {
          "command": "intellig.remoteBranch.checkoutAsLocal",
          "when": "viewItem == intellig.remoteBranch",
          "group": "1_branchOps@1"
        },
        {
          "command": "intellig.branch.newBranchFrom",
          "when": "viewItem == intellig.remoteBranch",
          "group": "1_branchOps@2"
        },
        {
          "command": "intellig.branch.checkoutAndRebase",
          "when": "viewItem == intellig.remoteBranch",
          "group": "1_branchOps@3"
        },
        {
          "command": "intellig.branch.compareWithCurrent",
          "when": "viewItem == intellig.remoteBranch",
          "group": "2_compare@1"
        },
        {
          "command": "intellig.branch.showDiffWithWorkingTree",
          "when": "viewItem == intellig.remoteBranch",
          "group": "2_compare@2"
        },
        {
          "command": "intellig.branch.rebaseCurrentOnto",
          "when": "viewItem == intellig.remoteBranch",
          "group": "3_integrate@1"
        },
        {
          "command": "intellig.branch.mergeIntoCurrent",
          "when": "viewItem == intellig.remoteBranch",
          "group": "3_integrate@2"
        },
        {
          "command": "intellig.remoteBranch.pullUsingRebase",
          "when": "viewItem == intellig.remoteBranch",
          "group": "4_pull@1"
        },
        {
          "command": "intellig.remoteBranch.pullUsingMerge",
          "when": "viewItem == intellig.remoteBranch",
          "group": "4_pull@2"
        },
        {
          "command": "intellig.remoteBranch.deleteRemote",
          "when": "viewItem == intellig.remoteBranch",
          "group": "5_manage@1"
        }
      ],
      "view/title": [],
      "explorer/context": [
        {
          "submenu": "intellig.explorerSubmenu",
          "when": "explorerResourceIsFolder == false",
          "group": "intellig@1"
        }
      ],
      "intellig.explorerSubmenu": [
        {
          "command": "intellig.explorer.showHistory",
          "group": "1_history@1"
        },
        {
          "command": "intellig.explorer.showDiff",
          "group": "1_history@2"
        },
        {
          "command": "intellig.explorer.compareWithBranch",
          "group": "1_history@3"
        },
        {
          "command": "intellig.explorer.stage",
          "group": "2_staging@1"
        },
        {
          "command": "intellig.explorer.unstage",
          "group": "2_staging@2"
        },
        {
          "command": "intellig.explorer.revert",
          "group": "3_revert@1"
        }
      ],
      "editor/context": [
        {
          "submenu": "intellig.editorSubmenu",
          "when": "editorTextFocus && resourceScheme == file",
          "group": "intellig@1"
        }
      ],
      "intellig.editorSubmenu": [
        {
          "command": "intellig.editor.toggleBlame",
          "group": "1_blame@1"
        },
        {
          "command": "intellig.editor.showLineHistory",
          "group": "2_history@1"
        },
        {
          "command": "intellig.editor.copyCommitHash",
          "group": "3_commit@1"
        },
        {
          "command": "intellig.editor.showCommit",
          "group": "3_commit@2"
        }
      ]
    },
    "submenus": [
      {
        "id": "intellig.explorerSubmenu",
        "label": "Git",
        "icon": "$(git-branch)"
      },
      {
        "id": "intellig.editorSubmenu",
        "label": "Git",
        "icon": "$(git-branch)"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "intellig",
          "title": "IntelliG",
          "icon": "resources/git-icon-branch.svg"
        }
      ]
    },
    "views": {
      "intellig": [
        {
          "type": "webview",
          "id": "intellig.toolWindow",
          "name": "Git"
        }
      ]
    },
    "configuration": {
      "title": "IntelliG",
      "properties": {
        "intellig.defaultCommitSignOff": {
          "type": "boolean",
          "default": false,
          "description": "Add Signed-off-by line to commit messages by default"
        },
        "intellig.commitMessageTemplate": {
          "type": "string",
          "default": "",
          "description": "Default commit message template"
        },
        "intellig.pullRebase": {
          "type": "boolean",
          "default": false,
          "description": "Use rebase instead of merge when pulling"
        },
        "intellig.autoFetchEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic fetching from remotes"
        },
        "intellig.autoFetchInterval": {
          "type": "number",
          "default": 180,
          "description": "Auto-fetch interval in seconds"
        },
        "intellig.blameAnnotationStyle": {
          "type": "string",
          "enum": [
            "inline",
            "gutter",
            "both"
          ],
          "default": "inline",
          "description": "Style for blame annotations"
        },
        "intellig.showStatusBarBranch": {
          "type": "boolean",
          "default": true,
          "description": "Show current branch in status bar"
        },
        "intellig.useIntelliJKeymap": {
          "type": "boolean",
          "default": false,
          "description": "Use IntelliJ-style keyboard shortcuts"
        },
        "intellig.keymapPreset": {
          "type": "string",
          "enum": [
            "default",
            "intellij"
          ],
          "enumDescriptions": [
            "Default VS Code-style keybindings",
            "IntelliJ IDEA-style keybindings (Alt+` for VCS popup, Ctrl+H for history, etc.)"
          ],
          "default": "default",
          "description": "Keyboard shortcut preset to use. IntelliJ preset uses IntelliJ IDEA's default Git keybindings."
        },
        "intellig.modifiedFileColor": {
          "type": "string",
          "default": "#6897BB",
          "description": "Color for modified files (IntelliJ blue)"
        },
        "intellig.addedFileColor": {
          "type": "string",
          "default": "#629755",
          "description": "Color for added files (IntelliJ green)"
        },
        "intellig.deletedFileColor": {
          "type": "string",
          "default": "#6C6C6C",
          "description": "Color for deleted files (IntelliJ gray)"
        },
        "intellig.ignoredFileColor": {
          "type": "string",
          "default": "#848504",
          "description": "Color for ignored files"
        },
        "intellig.conflictFileColor": {
          "type": "string",
          "default": "#FF0000",
          "description": "Color for conflicted files (red)"
        }
      }
    },
    "keybindings": [
      {
        "command": "intellig.commit",
        "key": "ctrl+k",
        "mac": "cmd+k",
        "when": "!inDebugMode && !terminalFocus"
      },
      {
        "command": "intellig.push",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k",
        "when": "!inDebugMode && !terminalFocus"
      },
      {
        "command": "intellig.pull",
        "key": "ctrl+t",
        "mac": "cmd+t",
        "when": "!inDebugMode && !terminalFocus"
      },
      {
        "command": "intellig.openGitToolWindow",
        "key": "alt+9",
        "mac": "cmd+9",
        "when": "!inDebugMode"
      },
      {
        "command": "intellig.showBranchPopup",
        "key": "ctrl+shift+`",
        "mac": "cmd+shift+`",
        "when": "!inDebugMode"
      },
      {
        "command": "intellig.refresh",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "!inDebugMode && !terminalFocus"
      },
      {
        "command": "intellig.stageSelected",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "!inDebugMode && !terminalFocus"
      },
      {
        "command": "intellig.unstageSelected",
        "key": "ctrl+alt+z",
        "mac": "cmd+alt+z",
        "when": "!inDebugMode && !terminalFocus"
      },
      {
        "command": "intellig.merge.nextConflict",
        "key": "alt+down",
        "when": "activeWebviewPanelId == 'intellig.mergeView'"
      },
      {
        "command": "intellig.merge.previousConflict",
        "key": "alt+up",
        "when": "activeWebviewPanelId == 'intellig.mergeView'"
      },
      {
        "command": "intellig.merge.acceptCurrent",
        "key": "alt+1",
        "when": "activeWebviewPanelId == 'intellig.mergeView'"
      },
      {
        "command": "intellig.merge.acceptBoth",
        "key": "alt+2",
        "when": "activeWebviewPanelId == 'intellig.mergeView'"
      },
      {
        "command": "intellig.merge.acceptIncoming",
        "key": "alt+3",
        "when": "activeWebviewPanelId == 'intellig.mergeView'"
      },
      {
        "command": "intellig.showBranchPopup",
        "key": "alt+`",
        "mac": "alt+`",
        "when": "!inDebugMode && config.intellig.useIntelliJKeymap"
      },
      {
        "command": "intellig.toggleBlame",
        "key": "ctrl+alt+shift+a",
        "mac": "cmd+alt+shift+a",
        "when": "editorTextFocus && config.intellig.useIntelliJKeymap"
      },
      {
        "command": "intellig.showHistory",
        "key": "ctrl+h",
        "mac": "cmd+h",
        "when": "!inDebugMode && config.intellig.useIntelliJKeymap"
      },
      {
        "command": "intellig.branch.compareWithCurrent",
        "key": "ctrl+d",
        "mac": "cmd+d",
        "when": "!inDebugMode && !terminalFocus && config.intellig.useIntelliJKeymap"
      },
      {
        "command": "intellig.revertFile",
        "key": "ctrl+alt+z",
        "mac": "cmd+alt+z",
        "when": "!inDebugMode && !terminalFocus && config.intellig.useIntelliJKeymap"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "lint:fix": "eslint src --ext ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "node ./out/test/runTest.js",
    "test:unit": "mocha --require ts-node/register 'src/test/unit/**/*.test.ts'",
    "test:property": "mocha --require ts-node/register --timeout 30000 'src/test/property/**/*.property.test.ts'"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vscode/test-electron": "^2.3.8",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "fast-check": "^3.14.0",
    "mocha": "^10.2.0",
    "prettier": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2"
  }
}
