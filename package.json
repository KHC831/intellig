          "when": "viewItem == intellig.logCommit",
          "group": "6_view@3"
        },
        {
          "command": "intellig.commit.showFileInRevision",
          "when": "viewItem == intellig.logCommit",
          "group": "7_files@1"
        },
        {
          "command": "intellig.commit.fileHistoryFromHere",
          "when": "viewItem == intellig.logCommit",
          "group": "7_files@2"
        },
        {
          "command": "intellig.rebase.interactiveFromHere",
          "when": "viewItem == intellig.logCommit",
          "group": "8_rebase@1"
        },
        {
          "command": "intellig.commit.createPatch",
          "when": "viewItem == intellig.logCommit",
          "group": "9_patch@1"
        },
        {
          "command": "intellig.commit.openOnHost",
          "when": "viewItem == intellig.logCommit",
          "group": "10_external@1"
        }
      ],
      "view/title": [],
      "explorer/context": [
        {
          "submenu": "intellig.explorerSubmenu",
          "when": "explorerResourceIsFolder == false",
          "group": "intellig@1"
        },
        {
          "command": "intellig.patch.apply",
          "when": "explorerResourceIsFolder == false && resourceExtname =~ /\\.(patch|diff)$/",
          "group": "9_patch@1"
        }
      ],
      "intellig.explorerSubmenu": [
        {
          "command": "intellig.explorer.showHistory",
          "group": "1_navigate@1"
        },
        {
          "command": "intellig.explorer.addToVcs",
          "group": "2_add@1"
        },
        {
          "command": "intellig.explorer.stage",
          "group": "2_add@2"
        },
        {
          "command": "intellig.explorer.unstage",
          "group": "2_add@3"
        },
        {
          "command": "intellig.explorer.revert",
          "group": "3_modify@1"
        },
        {
          "command": "intellig.explorer.showDiff",
          "group": "4_compare@1"
        },
        {
          "command": "intellig.explorer.compareWithBranch",
          "group": "4_compare@2"
        },
        {
          "command": "intellig.explorer.compareWithRepoVersion",
          "group": "4_compare@3"
        },
        {
          "command": "intellig.toggleBlame",
          "group": "5_blame@1"
        },
        {
          "command": "intellig.explorer.createPatchFromFile",
          "group": "6_patch@1"
        },
        {
          "command": "intellig.patch.apply",
          "group": "6_patch@2",
          "when": "resourceExtname =~ /\\.(patch|diff)$/"
        }
      ],
      "editor/context": [
        {
          "submenu": "intellig.editorSubmenu",
          "when": "editorTextFocus && resourceScheme == file",
          "group": "intellig@1"
        }
      ],
      "intellig.editorSubmenu": [
        {
          "command": "intellig.editor.toggleBlame",
          "group": "1_blame@1"
        },
        {
          "command": "intellig.editor.showLineHistory",
          "group": "2_history@1"
        },
        {
          "command": "intellig.showHistory",
          "group": "2_history@2"
        },
        {
          "command": "intellig.editor.copyCommitHash",
          "group": "3_commit@1"
        },
        {
          "command": "intellig.editor.showCommit",
          "group": "3_commit@2"
        },
        {
          "command": "intellig.revertFile",
          "group": "4_modify@1"
        },
        {
          "command": "intellig.patch.apply",
          "group": "6_patch@1"
        }
      ],
      "editor/lineNumber/context": [
        {
          "command": "intellig.blame.showCommit",
          "group": "1_commit@1"
        },
        {
          "command": "intellig.blame.copyRevision",
          "group": "1_commit@2"
        },
        {
          "command": "intellig.blame.annotatePrevious",
          "group": "2_navigate@1"
        },
        {
          "command": "intellig.blame.hideRevision",
          "group": "2_navigate@2"
        },
        {
          "submenu": "intellig.blameOptionsSubmenu",
          "group": "3_options@1"
        }
      ],
      "intellig.blameOptionsSubmenu": [
        {
          "command": "intellig.blame.toggleIgnoreWhitespace",
          "group": "1_whitespace@1"
        },
        {
          "command": "intellig.blame.toggleDetectMovementsWithinFile",
          "group": "2_movement@1"
        },
        {
          "command": "intellig.blame.toggleDetectMovementsAcrossFiles",
          "group": "2_movement@2"
        }
      ]
    },
    "submenus": [
      {
        "id": "intellig.explorerSubmenu",
        "label": "Git",
        "icon": "$(git-branch)"
      },
      {
        "id": "intellig.editorSubmenu",
        "label": "Git",
        "icon": "$(git-branch)"
      },
      {
        "id": "intellig.blameOptionsSubmenu",
        "label": "Annotations Options",
        "icon": "$(settings-gear)"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "intellig",
          "title": "IntelliG",
          "icon": "resources/git-icon-branch.svg"
        }
      ]
    },
    "views": {
      "intellig": [
        {
          "type": "webview",
          "id": "intellig.toolWindow",
          "name": "Git"
        },
        {
          "id": "intellig.branchTree",
          "name": "Branches"
        },
        {
          "type": "webview",
          "id": "intellig.commitToolWindow",
          "name": "Commit",
          "icon": "$(git-commit)",
          "when": "workbenchState != empty && config.intellig.useCommitToolWindow"
        }
      ]
    },
    "configuration": {
      "title": "IntelliG",
      "properties": {
        "intellig.defaultCommitSignOff": {
          "type": "boolean",
          "default": false,
          "description": "Add Signed-off-by line to commit messages by default"
        },
        "intellig.commitMessageIssueLinks": {
          "type": "boolean",
          "default": true,
          "description": "Detect issue/PR references (e.g. #42, GH-101, PROJ-7) in commit messages and render them as clickable links to the configured hosting provider."
        },
        "intellig.commitMessageTemplate": {
          "type": "string",
          "default": "",
          "description": "Default commit message template"
        },
        "intellig.commitAuthor": {
          "type": "string",
          "default": "",
          "description": "Default author override in 'Name <email>' format. Leave empty to use git config.",
          "pattern": "^(?:|[^<>]+ <[^<>@\\s]+@[^<>\\s]+>)$",
          "patternErrorMessage": "Expected 'Name <email@example.com>' or empty."
        },
        "intellig.pullRebase": {
          "type": "boolean",
          "default": false,
          "description": "Use rebase instead of merge when pulling"
        },
        "intellig.autoFetchEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic fetching from remotes"
        },
        "intellig.autoFetchInterval": {
          "type": "number",
          "default": 180,
          "description": "Auto-fetch interval in seconds"
        },
        "intellig.autoOpenResolveConflictsDialog": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open the Resolve Conflicts dialog when a merge/rebase/cherry-pick/revert/unshelve/unstash produces conflicts."
        },
        "intellig.useTabbedGitToolWindow": {
          "type": "boolean",
          "default": false,
          "description": "Experimental — show a tabbed Git tool window (Log / Console / Incoming / Update Info / History) instead of the single Log panel. When disabled, the UI is unchanged from earlier releases."
        },
        "intellig.useCommitToolWindow": {
          "type": "boolean",
          "default": false,
          "description": "Experimental — show the IntelliJ-style Commit tool window (Local Changes + Shelf tabs) in the IntelliG panel. When disabled, the Ctrl+K / Cmd+K shortcut opens the classic modal Commit dialog (unchanged from earlier releases)."
        },
        "intellig.defaultRepo": {
          "type": "string",
          "default": "",
          "description": "Repository basename or absolute path to use by default in multi-root workspaces. When empty, IntelliG uses the repo containing the active editor when unambiguous, otherwise prompts."
        },
        "intellig.log.highlightCherryPicked": {
          "type": "boolean",
          "default": true,
          "description": "Dim commits that are already cherry-picked to the current branch's upstream and show a ✓ badge (T3-07). Uses `git log --cherry-mark`. Turn off if you find the visual cue too busy."
        },
        "intellig.blameAnnotationStyle": {
          "type": "string",
          "enum": [
            "inline",
            "gutter",
            "both"
          ],
          "default": "inline",
          "description": "Style for blame annotations"
        },
        "intellig.blame.ignoreWhitespace": {
          "type": "boolean",
          "default": false,
          "description": "Ignore whitespace changes when computing Git blame (git blame -w). Matches IntelliJ's blame gutter Options menu."
        },
        "intellig.blame.detectMovementsWithinFile": {
          "type": "boolean",
          "default": false,
          "description": "Detect moved lines within the same file when computing Git blame (git blame -M). Matches IntelliJ's blame gutter Options menu."
        },
        "intellig.blame.detectMovementsAcrossFiles": {
          "type": "boolean",
          "default": false,
          "description": "Detect lines moved or copied across files when computing Git blame (git blame -C -C). Matches IntelliJ's blame gutter Options menu."
        },
        "intellig.showStatusBarBranch": {
          "type": "boolean",
          "default": true,
          "description": "Show current branch in status bar"
        },
        "intellig.useIntelliJKeymap": {
          "type": "boolean",
          "default": false,
          "description": "Use IntelliJ-style keyboard shortcuts"
        },
        "intellig.keymapPreset": {
          "type": "string",
          "enum": [
            "default",
            "intellij"
          ],
          "enumDescriptions": [
            "Default VS Code-style keybindings",
            "IntelliJ IDEA-style keybindings (Alt+` for VCS popup, Ctrl+H for history, etc.)"
          ],
          "default": "default",
          "description": "Keyboard shortcut preset to use. IntelliJ preset uses IntelliJ IDEA's default Git keybindings."
        },
        "intellig.modifiedFileColor": {
          "type": "string",
          "default": "#6897BB",
          "description": "Color for modified files (IntelliJ blue)"
        },
        "intellig.addedFileColor": {
          "type": "string",
          "default": "#629755",
          "description": "Color for added files (IntelliJ green)"
        },
        "intellig.deletedFileColor": {
          "type": "string",
          "default": "#6C6C6C",
          "description": "Color for deleted files (IntelliJ gray)"
        },
        "intellig.ignoredFileColor": {
          "type": "string",
          "default": "#848504",
          "description": "Color for ignored files"
        },
        "intellig.conflictFileColor": {
          "type": "string",
          "default": "#FF0000",
          "description": "Color for conflicted files (red)"
        },
        "intellig.protectedBranches": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "main",
            "master"
          ],
          "description": "Branches for which destructive operations are guarded: Reset modes Hard/Keep are disabled, and the Push dialog disables 'Force Push (Anyway)' (bare --force) when the target matches. '--force-with-lease' remains available. Remove a branch from this list to enable the guarded operations."
        },
        "intellig.shelve.removeAppliedFiles": {
          "type": "boolean",
          "default": false,
          "description": "When unshelving silently, remove successfully-applied files from the shelf entry. If all files apply cleanly, the entry is deleted. Matches IntelliJ's 'Remove successfully applied files from shelf' option."
        },
        "intellig.fetchTags": {
          "type": "string",
          "enum": [
            "auto",
            "all",
            "never"
          ],
          "enumDescriptions": [
            "Follow git's default tag-fetching behavior (no --tags / --no-tags flag added).",
            "Always pass --tags, fetching every tag regardless of reachability.",
            "Always pass --no-tags, skipping tag fetch entirely."
          ],
          "default": "auto",
          "description": "Tag-fetching policy applied to every fetch (manual + auto-fetch). Explicit user-passed --tags / --no-tags options in programmatic callers override this setting."
        }
      }
    },
    "keybindings": [
      {
        "command": "intellig.commit",
        "key": "ctrl+k",
        "mac": "cmd+k",
        "when": "!inDebugMode && !terminalFocus"
      },
      {
        "command": "intellig.shelve.silent",
        "key": "ctrl+shift+h",
        "mac": "cmd+shift+h",
        "when": "!inDebugMode && !terminalFocus"
      },
      {
        "command": "intellig.unshelve.silent",
        "key": "ctrl+alt+u",
        "mac": "cmd+alt+u",
        "when": "!inDebugMode && !terminalFocus"
      },
      {
        "command": "intellig.showCommitToolWindow",
        "key": "alt+0",
        "when": "!terminalFocus"
      },
      {
        "command": "intellig.push",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k",
        "when": "!inDebugMode && !terminalFocus"
      },
      {
        "command": "intellig.pull",
        "key": "ctrl+t",
        "mac": "cmd+t",
        "when": "!inDebugMode && !terminalFocus"
      },
      {
        "command": "intellig.openGitToolWindow",
        "key": "alt+9",
        "mac": "cmd+9",
        "when": "!inDebugMode"
      },
      {
        "command": "intellig.toolWindow.jumpToHash",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "focusedView == 'intellig.toolWindow' && intellig.toolWindow.activeTab == 'log'"
      },
      {
        "command": "intellig.showBranchPopup",
        "key": "ctrl+shift+`",
        "mac": "cmd+shift+`",
        "when": "!inDebugMode"
      },
      {
        "command": "intellig.refresh",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "!inDebugMode && !terminalFocus"
      },
      {
        "command": "intellig.stageSelected",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "!inDebugMode && !terminalFocus"
      },
      {
        "command": "intellig.unstageSelected",
        "key": "ctrl+alt+z",
        "mac": "cmd+alt+z",
        "when": "!inDebugMode && !terminalFocus"
      },
      {
        "command": "intellig.merge.nextConflict",
        "key": "alt+down",
        "when": "activeWebviewPanelId == 'intellig.mergeView'"
      },
      {
        "command": "intellig.merge.previousConflict",
        "key": "alt+up",
        "when": "activeWebviewPanelId == 'intellig.mergeView'"
      },
      {
        "command": "intellig.merge.acceptCurrent",
        "key": "alt+1",
        "when": "activeWebviewPanelId == 'intellig.mergeView'"
      },
      {
        "command": "intellig.merge.acceptBoth",
        "key": "alt+2",
        "when": "activeWebviewPanelId == 'intellig.mergeView'"
      },
      {
        "command": "intellig.merge.acceptIncoming",
        "key": "alt+3",
        "when": "activeWebviewPanelId == 'intellig.mergeView'"
      },
      {
        "command": "intellig.showBranchPopup",
        "key": "alt+`",
        "mac": "alt+`",
        "when": "!inDebugMode && config.intellig.useIntelliJKeymap"
      },
      {
        "command": "intellig.toggleBlame",
        "key": "ctrl+alt+shift+a",
        "mac": "cmd+alt+shift+a",
        "when": "editorTextFocus && config.intellig.useIntelliJKeymap"
      },
      {
        "command": "intellig.showHistory",
        "key": "ctrl+h",
        "mac": "cmd+h",
        "when": "!inDebugMode && config.intellig.useIntelliJKeymap"
      },
      {
        "command": "intellig.branch.compareWithCurrent",
        "key": "ctrl+d",
        "mac": "cmd+d",
        "when": "!inDebugMode && !terminalFocus && config.intellig.useIntelliJKeymap"
      },
      {
        "command": "intellig.revertFile",
        "key": "ctrl+alt+z",
        "mac": "cmd+alt+z",
        "when": "!inDebugMode && !terminalFocus && config.intellig.useIntelliJKeymap"
      },
      {
        "command": "intellig.showShelfList",
        "key": "ctrl+shift+u",
        "mac": "cmd+shift+u",
        "when": "!inDebugMode && !terminalFocus && config.intellig.keymapPreset == 'intellij'"
      },
      {
        "command": "intellig.localChanges.openFile",
        "key": "f4",
        "when": "!inDebugMode && config.intellig.keymapPreset == 'intellij'"
      },
      {
        "command": "intellig.changelist.moveFilesTo",
        "key": "f6",
        "when": "!inDebugMode && config.intellig.keymapPreset == 'intellij'"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "lint:fix": "eslint src --ext ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "node ./out/test/runTest.js",
    "test:unit": "mocha --require ts-node/register 'src/test/unit/**/*.test.ts'",
    "test:property": "mocha --require ts-node/register --timeout 30000 'src/test/property/**/*.property.test.ts'",
    "test:property:stress": "node scripts/propertyStress.mjs",
    "test:ext-host": "npm run compile && node ./out/test/ext-host/runTests.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vscode/test-electron": "^2.3.8",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "fast-check": "^3.14.0",
    "mocha": "^10.2.0",
    "prettier": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2"
  }
}
